 }
 
+void filter_rc_scan(INT32 nAction)
+{
+	if (!(nAction & ACB_DRIVER_DATA)) return;
+
+	// ReplayArcade: an RC filter's output follows its memory (the charge of its capacitor); a load
+	// left the last run's.
+	for (INT32 i = 0; i < num_filters && i < FLT_RC_NUM; i++) {
+		SCAN_VAR(flt_rc_table[i].state.memory);
+	}
+}
