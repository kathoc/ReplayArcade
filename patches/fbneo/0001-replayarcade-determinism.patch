+int FMChipMemory(void **ptrs, int *sizes)
+{
+	int n = 0;
+#if BUILD_YM2203
+	if (FM2203) { ptrs[n] = FM2203; sizes[n] = (int)(sizeof(YM2203) * YM2203NumChips); n++; }
+#endif
+#if BUILD_YM2608
+	if (FM2608) { ptrs[n] = FM2608; sizes[n] = (int)(sizeof(YM2608) * YM2608NumChips); n++; }
+#endif
+#if (BUILD_YM2610||BUILD_YM2610B)
+	if (FM2610) { ptrs[n] = FM2610; sizes[n] = (int)(sizeof(YM2610) * YM2610NumChips); n++; }
+#endif
+#if (BUILD_YM2612||BUILD_YM3438)
+	if (FM2612) { ptrs[n] = FM2612; sizes[n] = (int)(sizeof(YM2612) * YM2612NumChips); n++; }
+#endif
+	return n;
+}
