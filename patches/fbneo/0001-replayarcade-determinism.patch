+		ScanVar(&OPN->type, sizeof(OPN->type), (char*)"YM2608 type");
+		ScanVar(&OPN->lfo_cnt, sizeof(OPN->lfo_cnt), (char*)"YM2608 lfo_cnt");
+		ScanVar(&OPN->lfo_inc, sizeof(OPN->lfo_inc), (char*)"YM2608 lfo_inc");
+		ScanVar(&OPN->eg_cnt, sizeof(OPN->eg_cnt), (char*)"YM2608 eg_cnt");
+		ScanVar(&OPN->eg_timer, sizeof(OPN->eg_timer), (char*)"YM2608 eg_timer");
+	}
+#endif
+#if (BUILD_YM2610||BUILD_YM2610B)
+	for (num = 0; FM2610 && num < YM2610NumChips; num++) {
+		FM_OPN *OPN = &FM2610[num].OPN;
+		ScanVar(&OPN->type, sizeof(OPN->type), (char*)"YM2610 type");
+		ScanVar(&OPN->lfo_cnt, sizeof(OPN->lfo_cnt), (char*)"YM2610 lfo_cnt");
+		ScanVar(&OPN->lfo_inc, sizeof(OPN->lfo_inc), (char*)"YM2610 lfo_inc");
+		ScanVar(&OPN->eg_cnt, sizeof(OPN->eg_cnt), (char*)"YM2610 eg_cnt");
+		ScanVar(&OPN->eg_timer, sizeof(OPN->eg_timer), (char*)"YM2610 eg_timer");
+	}
+#endif
+#if (BUILD_YM2612||BUILD_YM3438)
+	for (num = 0; FM2612 && num < YM2612NumChips; num++) {
+		ScanVar(&FM2612[num].OPN.type, sizeof(FM2612[num].OPN.type), (char*)"YM2612 type");
+	}
+#endif
+}
+
+/* ReplayArcade: where the chips live (malloc'd, not BurnMalloc'd), for tools/fbneo_bisect, which compares
+   the drivers' memory between two runs. Writes up to 4 (pointer, size) pairs; returns how many. */
+int FMChipMemory(void **ptrs, int *sizes)
+{
+	int n = 0;
+#if BUILD_YM2203
+	if (FM2203) { ptrs[n] = FM2203; sizes[n] = (int)(sizeof(YM2203) * YM2203NumChips); n++; }
+#endif
+#if BUILD_YM2608
+	if (FM2608) { ptrs[n] = FM2608; sizes[n] = (int)(sizeof(YM2608) * YM2608NumChips); n++; }
+#endif
+#if (BUILD_YM2610||BUILD_YM2610B)
+	if (FM2610) { ptrs[n] = FM2610; sizes[n] = (int)(sizeof(YM2610) * YM2610NumChips); n++; }
+#endif
+#if (BUILD_YM2612||BUILD_YM3438)
+	if (FM2612) { ptrs[n] = FM2612; sizes[n] = (int)(sizeof(YM2612) * YM2612NumChips); n++; }
+#endif
+	return n;
+}
