diff --git a/src/burn/state.h b/src/burn/state.h
index c4d9bd8d5..b78cd3b78 100644
--- a/src/burn/state.h
+++ b/src/burn/state.h
@@ -15,6 +15,27 @@
 /* Scan driver data */
 INT32 BurnAreaScan(INT32 nAction, INT32* pnMin); // burn.cpp
 
+/* ReplayArcade: the layout of its save states, each version adding what the one before left out (a state
+   load restored the machine but not all of it): 1 = upstream (ReplayArcade 0.2.1 and earlier), 2 = 0.3.0
+   and 0.3.1, 3 (current) = later. A state of an older version is loaded with this set to its version for
+   that load (its size tells), so the projects saved before still open. Additions since version n are
+   scanned only when > n. */
+extern INT32 nReplayArcadeScanVersion;
+
+/* ReplayArcade: emulation state that FinalBurn Neo kept in function statics (a coin's previous level,
+   a 4-way stick's last direction, a read counter): moved to file scope and registered here, so that
+   state version 2 scans it (all of them for every game, in the order of their names: the same on
+   every platform). Use: "static UINT8 d_btime_prevcoin = 0; REPLAYARCADE_STATE(d_btime_prevcoin);"
+   with a name unique in all of FBNeo (file and variable), and in the function "UINT8 &prevcoin =
+   d_btime_prevcoin;" (the code that uses it unchanged). */
+#ifdef __cplusplus
+struct ReplayArcadeState {
+	ReplayArcadeState(void* pv, INT32 nSize, const char* szName);
+};
+#define REPLAYARCADE_STATE(x) static ReplayArcadeState x##_replayarcade(&(x), sizeof(x), #x)
+#endif
+void ReplayArcadeStateScan(INT32 nAction); // burn.cpp
+
 /* ReWind */
 void StateRewindInit();
 void StateRewindExit();
diff --git a/src/burn/tilemap_generic.cpp b/src/burn/tilemap_generic.cpp
index 8f5e48cd1..39e3b667d 100644
--- a/src/burn/tilemap_generic.cpp
+++ b/src/burn/tilemap_generic.cpp
@@ -34,6 +34,32 @@ static GenericTilemap maps[MAX_TILEMAPS];
 static GenericTilemap *cur_map;
 GenericTilesGfx GenericGfxData[MAX_TILEMAPS];
 
+// ReplayArcade: a tilemap's display settings are machine state where a driver sets them only when the
+// game writes its registers (Xevious's scroll); a load left the last run's. Scanned with every game's
+// state (burn.cpp); the layout (sizes, tables' lengths) is the driver's, fixed at init.
+void GenericTilemapScan(INT32 nAction)
+{
+	if (!(nAction & ACB_DRIVER_DATA)) return;
+	for (INT32 i = 0; i < MAX_TILEMAPS; i++) {
+		GenericTilemap *t = &maps[i];
+		if (!t->initialized) continue;
+		SCAN_VAR(t->enable);
+		SCAN_VAR(t->scrollx);
+		SCAN_VAR(t->scrolly);
+		SCAN_VAR(t->priority);
+		SCAN_VAR(t->xoffset);
+		SCAN_VAR(t->yoffset);
+		SCAN_VAR(t->flags);
+		SCAN_VAR(t->transcolor);
+		if (t->scrollx_table) ScanVar(t->scrollx_table, t->scroll_rows * sizeof(INT32), (char*)"tilemap scroll x");
+		if (t->scrolly_table) ScanVar(t->scrolly_table, t->scroll_cols * sizeof(INT32), (char*)"tilemap scroll y");
+		// State version 3: which tiles are still to be drawn into a cached bitmap (GenericTilemapUseDirtyTiles:
+		// System 32); a load kept the last run's marks, so tiles were left undrawn or drawn again.
+		if (nReplayArcadeScanVersion >= 3 && t->dirty_tiles_enable && t->dirty_tiles)
+			ScanVar(t->dirty_tiles, t->mwidth * t->mheight, (char*)"tilemap dirty tiles");
+	}
+}
+
 void GenericTilemapInit(INT32 which, INT32 (*pScan)(INT32 col, INT32 row), void (*pTile)(INT32 offs, GenericTilemapCallbackStruct *sTile), UINT32 tile_width, UINT32 tile_height, UINT32 map_width, UINT32 map_height)
 {
 #if defined FBNEO_DEBUG
