+/* ReplayArcade: chip state the save states leave out, scanned with every game's state (state layout 2,
+   burn.cpp). OPN.type: SSG-EG rewrites it at run time (the "=" in the SSG-EG test of FM_ADVANCE_EG
+   makes any OPN a YM2612 once a slot uses SSG-EG; kept as upstream has it), so a load left the last
+   run's type. YM2608 / YM2610: the envelope and LFO counters, which YM2203 and YM2612 already save. */
+void FMReplayArcadeScan(int nAction)
+{
+	int num;
+	if (!(nAction & ACB_DRIVER_DATA)) return;
+#if BUILD_YM2203
+	for (num = 0; FM2203 && num < YM2203NumChips; num++) {
+		ScanVar(&FM2203[num].OPN.type, sizeof(FM2203[num].OPN.type), (char*)"YM2203 type");
