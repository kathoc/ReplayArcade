+	// ReplayArcade: the drawing bitmaps (pTransDraw, pPrioDraw, the drivers' others) carry the picture
+	// from frame to frame where a driver does not redraw all of it; a load left the previous run's.
+	if ((nAction & ACB_DRIVER_DATA) && nReplayArcadeScanVersion >= 2) {
+		BurnBitmapScan(nAction);
+		for (INT32 i = 0; i < nBurnBiqCount; i++) BurnBiqList[i]->scan();
+		filter_rc_scan(nAction);
+		BurnSoundFilterScan(nAction);
+		GenericTilemapScan(nAction);
+		FMReplayArcadeScan(nAction);
+		ReplayArcadeStateScan(nAction);
+	}
+
 #ifdef __LIBRETRO__
 	// standalone method to handle hiscores with runahead
 	// doesn't work with libretro's second instance or 2+ frames
