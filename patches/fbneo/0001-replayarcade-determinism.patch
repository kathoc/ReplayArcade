diff --git a/src/burn/snd/stream.h b/src/burn/snd/stream.h
index df9fbef07..278543c56 100644
--- a/src/burn/snd/stream.h
+++ b/src/burn/snd/stream.h
@@ -71,6 +71,21 @@ struct Stream {
 		nSampleSize = nFractionalPosition = 0;
 		stream_exit();
 	}
+	// ReplayArcade: the resampler position and the carried-over samples decide what the next frame
+	// renders, so they are machine state. Fixed size: render() carries in_buffer[-1 .. nPosition-1],
+	// i.e. soundbuf[0 .. nPosition], and nPosition is a handful of samples at a frame boundary.
+	void scan(INT32 nAction, INT32 * /*pnMin*/) {
+		if (!(nAction & ACB_DRIVER_DATA)) return;
+		SCAN_VAR(nFractionalPosition);
+		SCAN_VAR(nPosition);
+		SCAN_VAR(nSampleRateFrom);
+		SCAN_VAR(bRateChange);
+		SCAN_VAR(nNewRate);
+		for (INT32 ch = 0; ch < nChannels; ch++) {
+			ScanVar(soundbuf[ch], 32 * sizeof(INT16), (char*)"Stream carry-over");
+		}
+		if (nAction & ACB_WRITE) set_rate_internal(nSampleRateFrom);
+	}
 	INT32 samples_to_host(INT32 samples) {
 		return (INT32)((UINT64)nSampleSize_Otherway * samples) / (1 << 16);
 	}
