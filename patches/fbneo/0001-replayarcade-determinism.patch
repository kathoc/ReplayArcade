+		ScanVar(&OPN->lfo_cnt, sizeof(OPN->lfo_cnt), (char*)"YM2608 lfo_cnt");
+		ScanVar(&OPN->lfo_inc, sizeof(OPN->lfo_inc), (char*)"YM2608 lfo_inc");
+		ScanVar(&OPN->eg_cnt, sizeof(OPN->eg_cnt), (char*)"YM2608 eg_cnt");
+		ScanVar(&OPN->eg_timer, sizeof(OPN->eg_timer), (char*)"YM2608 eg_timer");
+		if (nReplayArcadeScanVersion >= 3) {  /* see the YM2610 below */
+			ScanVar(OPN->pan, sizeof(OPN->pan), (char*)"YM2608 pan");
+			SCAN_OFF(FM2608[num].deltaT.pan, FM2608[num].deltaT.output_pointer, nAction);
+		}
+	}
+#endif
+#if (BUILD_YM2610||BUILD_YM2610B)
+	for (num = 0; FM2610 && num < YM2610NumChips; num++) {
+		FM_OPN *OPN = &FM2610[num].OPN;
+		ScanVar(&OPN->type, sizeof(OPN->type), (char*)"YM2610 type");
+		ScanVar(&OPN->lfo_cnt, sizeof(OPN->lfo_cnt), (char*)"YM2610 lfo_cnt");
+		ScanVar(&OPN->lfo_inc, sizeof(OPN->lfo_inc), (char*)"YM2610 lfo_inc");
+		ScanVar(&OPN->eg_cnt, sizeof(OPN->eg_cnt), (char*)"YM2610 eg_cnt");
+		ScanVar(&OPN->eg_timer, sizeof(OPN->eg_timer), (char*)"YM2610 eg_timer");
+		/* State version 3: each channel's left / right outputs (the postload rewrites 0xb0 - 0xb5 only, so the
+		   L / R register of channels 2 and 5, 0xb6, was left as the last run's: Darius II, Night Striker) and
+		   the ADPCM-B's panning (a pointer into its outputs, saved as the index). */
+		if (nReplayArcadeScanVersion >= 3) {
