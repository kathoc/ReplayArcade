+		pandora_scan(nAction);
+		// A driver's converted palette is kept up to date colour by colour as the game writes its palette RAM,
+		// and most drivers do not save it (Flipull): after a load, convert it all again on the next draw.
+		if ((nAction & ACB_WRITE) && pDriver[nBurnDrvActive]->pRecalcPal) *(pDriver[nBurnDrvActive]->pRecalcPal) = 1;
