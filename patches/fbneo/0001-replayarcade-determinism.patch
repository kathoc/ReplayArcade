+// ReplayArcade: the biquad filters a game set up (snd/biquad.h), in the order it did: their memory is
+// machine state. The list starts empty with each game.
+#include "biquad.h"
+static BIQ* BurnBiqList[64];
+static INT32 nBurnBiqCount = 0;
+
+// ReplayArcade: the sound Streams in use (snd/stream.h), in the order the game set them up; state version 3
+// scans them (BurnAreaScan).
+struct BurnStreamEntry { void *stream; void (*scan)(void *, INT32); };
+static BurnStreamEntry BurnStreamList[64];
+static INT32 nBurnStreamCount = 0;
+void BurnStreamRegister(void *stream, void (*scan)(void *, INT32), INT32 add)
+{
+	for (INT32 i = 0; i < nBurnStreamCount; i++) {
+		if (BurnStreamList[i].stream != stream) continue;
+		if (!add) {
+			for (INT32 j = i; j + 1 < nBurnStreamCount; j++) BurnStreamList[j] = BurnStreamList[j + 1];
+			nBurnStreamCount--;
+		}
+		return;
+	}
+	if (add && nBurnStreamCount < 64) {
+		BurnStreamEntry e = { stream, scan };
+		BurnStreamList[nBurnStreamCount++] = e;
+	}
+}
+void BurnBiqRegister(BIQ* biq)
+{
+	for (INT32 i = 0; i < nBurnBiqCount; i++) if (BurnBiqList[i] == biq) return;
+	if (nBurnBiqCount < 64) BurnBiqList[nBurnBiqCount++] = biq;
+}
 
