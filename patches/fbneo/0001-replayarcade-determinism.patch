+// ReplayArcade (state version 3): the tilemap cache as it was (which entry holds which page and bank, which
+// are dirty, and the list's order, as entry indices: it is a list of pointers). Its drawn bitmaps are saved with
+// the other bitmaps (BurnBitmapScan); a load kept the last run's cache, so pages were drawn from entries that
+// held others. Rebuilding the cache instead would draw them afresh, not as the run being replayed drew them.
+static void tilemap_cache_scan(INT32 nAction)
+{
+	UINT8 page[32], bank[32], dirty[32];
+	INT8 order[32];
+	INT32 n = 0;
+	for (INT32 i = 0; i < 32; i++) { page[i] = tmap_cache[i].page; bank[i] = tmap_cache[i].bank; dirty[i] = tmap_cache[i].dirty; order[i] = -1; }
+	for (cache_entry *e = cache_head; e != NULL && n < 32; e = e->next) order[n++] = (INT8)(e - tmap_cache);
+	SCAN_VAR(page);
+	SCAN_VAR(bank);
+	SCAN_VAR(dirty);
+	SCAN_VAR(order);
+	if (nAction & ACB_WRITE) {
+		cache_head = NULL;
+		cache_entry **link = &cache_head;
+		for (INT32 i = 0; i < 32; i++) {
+			tmap_cache[i].page = page[i];
+			tmap_cache[i].bank = bank[i];
+			tmap_cache[i].dirty = dirty[i];
+			tmap_cache[i].next = NULL;
+		}
+		for (INT32 i = 0; i < 32 && order[i] >= 0 && order[i] < 32; i++) {
+			*link = &tmap_cache[order[i]];
+			link = &tmap_cache[order[i]].next;
+		}
+	}
