+// ReplayArcade: the registry of REPLAYARCADE_STATE (state.h). Filled by static constructors before
+// main (plain zero-initialised storage, so the order of the files' initialisation does not matter).
+struct ReplayArcadeStateEntry { void* pv; INT32 nSize; const char* szName; };
+static ReplayArcadeStateEntry* pReplayArcadeStates = NULL;
+static INT32 nReplayArcadeStates = 0, nReplayArcadeStatesCap = 0, bReplayArcadeStatesSorted = 0;
+
+ReplayArcadeState::ReplayArcadeState(void* pv, INT32 nSize, const char* szName)
+{
+	if (nReplayArcadeStates == nReplayArcadeStatesCap) {
+		nReplayArcadeStatesCap = nReplayArcadeStatesCap ? nReplayArcadeStatesCap * 2 : 64;
+		pReplayArcadeStates = (ReplayArcadeStateEntry*)realloc(pReplayArcadeStates, nReplayArcadeStatesCap * sizeof(ReplayArcadeStateEntry));
+	}
+	ReplayArcadeStateEntry e = { pv, nSize, szName };
+	pReplayArcadeStates[nReplayArcadeStates++] = e;
+	bReplayArcadeStatesSorted = 0;
+}
+
+static int ReplayArcadeStateCompare(const void* a, const void* b)
+{
+	return strcmp(((const ReplayArcadeStateEntry*)a)->szName, ((const ReplayArcadeStateEntry*)b)->szName);
+}
+
+void ReplayArcadeStateScan(INT32 nAction)
+{
+	if ((nAction & ACB_DRIVER_DATA) == 0) return;
+	if (!bReplayArcadeStatesSorted) {
+		qsort(pReplayArcadeStates, nReplayArcadeStates, sizeof(ReplayArcadeStateEntry), ReplayArcadeStateCompare);
+		bReplayArcadeStatesSorted = 1;
+	}
+	for (INT32 i = 0; i < nReplayArcadeStates; i++) {
+		struct BurnArea ba;
+		memset(&ba, 0, sizeof(ba));
+		ba.Data   = pReplayArcadeStates[i].pv;
+		ba.nLen   = pReplayArcadeStates[i].nSize;
+		ba.szName = (char*)pReplayArcadeStates[i].szName;
+		BurnAcb(&ba);
+	}
+}
