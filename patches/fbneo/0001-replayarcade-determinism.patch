+void BurnSoundFilterScan(INT32 nAction); // burn_sound.cpp
+void GenericTilemapScan(INT32 nAction); // tilemap_generic.cpp
+extern "C" void FMReplayArcadeScan(int nAction); // snd/fm.c
+void pandora_scan(INT32 nAction); // devices/pandora.cpp
