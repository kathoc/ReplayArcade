// Signing for device builds. A free Apple ID ("Personal Team") is enough for your own iPhone.
// Do not edit this file: put your values in Signing.local.xcconfig next to it (not committed):
//   DEVELOPMENT_TEAM = ABCDE12345
//   PRODUCT_BUNDLE_IDENTIFIER = io.github.<you>.replaynes.dev
// (scripts/build-device.sh writes it for you; see README.md.)
PRODUCT_BUNDLE_IDENTIFIER = io.github.replaynes.dev
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
#include? "Signing.local.xcconfig"
