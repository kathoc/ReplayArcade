{
  "sourceLanguage": "en",
  "strings": {
    "Add": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "Add %lld file(s) to ReplayNES": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 本をReplayNESに追加"
          }
        }
      }
    },
    "Adding…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加中…"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Item %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目 %lld"
          }
        }
      }
    },
    "None of the files could be read.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めませんでした。"
          }
        }
      }
    },
    "The shared folder isn’t available (App Group).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有フォルダ（App Group）を使えません。"
          }
        }
      }
    },
    "They are imported into the library when ReplayNES opens.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ReplayNES を開くとライブラリに読み込まれます。"
          }
        }
      }
    },
    "and %lld more": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほか %lld 本"
          }
        }
      }
    }
  },
  "version": "1.0"
}
