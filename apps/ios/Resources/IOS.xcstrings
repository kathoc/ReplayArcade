{
  "sourceLanguage": "en",
  "strings": {
    "%lld already in the library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 本は追加済み"
          }
        }
      }
    },
    "%lld skipped (not an NES ROM or unreadable)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件をスキップ（NESのROMではないか読み込めません）"
          }
        }
      }
    },
    "%lld skipped (not a ROM zip or unreadable)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件をスキップ（ROMのzipではないか読み込めません）"
          }
        }
      }
    },
    "+1 frame": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+1コマ"
          }
        }
      }
    },
    "4-way ignores diagonals (remembered per game)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4方向では斜めを無視します（ゲームごとに記憶）"
          }
        }
      }
    },
    "8:7 pixels, hide the edges, orientation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "8:7・端を隠す・画面の向き"
          }
        }
      }
    },
    "A backup copy of the project is kept in the Backups folder first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にプロジェクトのバックアップを Backups フォルダに作成します。"
          }
        }
      }
    },
    "A short vibration when a button is pressed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを押したときに短く振動します"
          }
        }
      }
    },
    "Add Test Cartridge": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストカートリッジを追加"
          }
        }
      }
    },
    "Add to Favorites": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに追加"
          }
        }
      }
    },
    "Added %lld ROM(s)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 本のROMを追加しました"
          }
        }
      }
    },
    "Added %lld project(s) to the Projects folder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のプロジェクトを Projects フォルダに追加しました"
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        }
      }
    },
    "Auto follows the iPhone · Portrait / Landscape lock the screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動：iPhoneの向きに合わせる・縦／横：その向きに固定"
          }
        }
      }
    },
    "Back to Game": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームに戻る"
          }
        }
      }
    },
    "Cancel Countdown": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウンをやめる"
          }
        }
      }
    },
    "CRT Display": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CRT表示"
          }
        }
      }
    },
    "Codec": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーデック"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続きから"
          }
        }
      }
    },
    "D-pad Directions": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十字キーの方向数"
          }
        }
      }
    },
    "D-pad Follow ↔︎": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追従 ↔︎"
          }
        }
      }
    },
    "D-pad Follow ↕︎": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追従 ↕︎"
          }
        }
      }
    },
    "D-pad Size": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十字キー"
          }
        }
      }
    },
    "D-pad size and follow, opacity, turbo buttons and vibration of the on-screen controls": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のコントローラーの十字キー（大きさ・追従）、不透明度、連射ボタン、振動"
          }
        }
      }
    },
    "Details": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細"
          }
        }
      }
    },
    "Export": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出す"
          }
        }
      }
    },
    "Export a take as an MP4 video (H.264 / HEVC)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テイクをMP4動画（H.264 / HEVC）で書き出します"
          }
        }
      }
    },
    "Make a video": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画にする"
          }
        }
      }
    },
    "Exported to Files › %@ › Exports": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル › %@ › Exports に書き出しました"
          }
        }
      }
    },
    "Exporting MP4 videos needs the MP4 Export unlock.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4動画の書き出しには「MP4書き出し」のアンロックが必要です。"
          }
        }
      }
    },
    "Features": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能"
          }
        }
      }
    },
    "Forget Simulated Purchases": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "擬似購入を消去"
          }
        }
      }
    },
    "Free: play, rewind, fast-forward, practice and replay the current session. Nothing is sold in this test build: “Unlock” only simulates a purchase on this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料：プレイ、巻き戻し、早送り、練習、現在のセッションのリプレイ。このテストビルドでは何も販売していません。「アンロック」はこの端末で購入を擬似的に再現するだけです。"
          }
        }
      }
    },
    "Hide With Controller": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラ接続時に隠す"
          }
        }
      }
    },
    "Hide the on-screen controls while a controller is connected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラが接続されている間は画面上のボタンを隠します"
          }
        }
      }
    },
    "How fast the D-pad follows your thumb left and right": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十字キーが親指の左右のずれに追従する速さ"
          }
        }
      }
    },
    "How fast the D-pad follows your thumb up and down": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "十字キーが親指の上下のずれに追従する速さ"
          }
        }
      }
    },
    "How visible the on-screen controls are": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のボタンの見やすさ"
          }
        }
      }
    },
    "Import ROMs": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ROMを読み込む"
          }
        }
      }
    },
    "Imported %lld ROM(s)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ROMを%lld本読み込みました"
          }
        }
      }
    },
    "Importing %lld files…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のファイルを読み込んでいます…"
          }
        }
      }
    },
    "Integer: sharp pixels · FILL: as large as the screen allows": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整数倍：くっきりしたドット・FILL：画面いっぱいに表示"
          }
        }
      }
    },
    "Keep as Project": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトとして残す"
          }
        }
      }
    },
    "Keep every recording as a project: saved per game, listed in the library, openable on the Mac": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての記録をプロジェクトとして残せます：ゲームごとに保存、ライブラリに表示、Macでも開けます"
          }
        }
      }
    },
    "Keep practicing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習を続ける"
          }
        }
      }
    },
    "Keep the previous session (ROM: %@) as a project in the Projects folder? If you don’t keep it, it is discarded.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のセッション（ROM：%@）を Projects フォルダにプロジェクトとして残しますか？残さない場合は破棄されます。"
          }
        }
      }
    },
    "Keep this recording as a project (it is also saved automatically)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記録をプロジェクトとして残します（自動でも保存されます）"
          }
        }
      }
    },
    "Keep watching the tape": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生を続ける"
          }
        }
      }
    },
    "Kept as a project": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトとして残しました"
          }
        }
