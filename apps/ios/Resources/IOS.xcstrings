    "Portrait": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦"
          }
        }
      }
    },
    "Prototype switch: every paid feature works without a purchase": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試作用スイッチ：購入しなくても有料機能がすべて使えます"
          }
        }
      }
    },
    "Purchases aren’t available in this test build": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテストビルドでは購入できません"
          }
        }
      }
    },
    "Put the ROM “%1$@” into the ROM folder (Files › On My iPhone › %2$@ › ROM) and try again.\nSHA-256: %3$@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ROM「%1$@」をROMフォルダ（ファイル › このiPhone内 › %2$@ › ROM）に入れてから、もう一度試してください。\nSHA-256：%3$@"
          }
        }
      }
    },
    "Put your .nes ROM files into Files › On My iPhone › %1$@ › ROM (from a Mac: Finder › your iPhone › Files › %2$@), or import them here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".nes のROMファイルを「ファイル › このiPhone内 › %1$@ › ROM」に入れるか（Macからは Finder › iPhone › ファイル › %2$@）、ここから読み込んでください。"
          }
        }
      }
    },
    "Put your ROM zips (FinalBurn Neo set names) into Files › On My iPhone › %1$@ › ROM (from a Mac: Finder › your iPhone › Files › %2$@), or import them here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ROMのzip（FinalBurn Neo のセット名）を「ファイル › このiPhone内 › %1$@ › ROM」に入れるか（Macからは Finder › iPhone › ファイル › %2$@）、ここから読み込んでください。"
          }
        }
      }
    },
