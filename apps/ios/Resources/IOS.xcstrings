    "Open it with the version of %@ it was recorded with. See docs/COMPATIBILITY.md for details.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録したときのバージョンの %@ で開いてください。詳しくは docs/COMPATIBILITY.md を参照してください。"
          }
        }
      }
    },
    "Orientation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の向き"
          }
        }
      }
