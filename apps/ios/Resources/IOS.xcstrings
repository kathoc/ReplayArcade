    "Play": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイ"
          }
        }
      }
    },
    "Play (New Recording)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイ（新しい記録）"
          }
        }
      }
