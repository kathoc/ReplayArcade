      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示"
          }
        }
      }
    },
    "Show AA / BB (Turbo A / Turbo B) up-left of A / B": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "A / B の左斜め上に AA / BB（連射A / 連射B）を表示します"
          }
        }
      }
    },
